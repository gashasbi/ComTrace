{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-x64-debug",
      "displayName": "Windows | MSVC x64 | Debug",
      "description": "Build with the MSVC x64 toolchain.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-msvc-x64-release",
      "displayName": "Windows | MSVC x64 | Release",
      "description": "Build with the MSVC x64 toolchain.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-vs2022-x64",
      "displayName": "Windows | Visual Studio 2022 | x64",
      "description": "Generate a Visual Studio solution using the MSVC x64 toolchain.",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/out/build/${presetName}"
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-x64-debug",
      "displayName": "Windows | MSVC x64 | Debug",
      "configurePreset": "windows-msvc-x64-debug"
    },
    {
      "name": "windows-msvc-x64-release",
      "displayName": "Windows | MSVC x64 | Release",
      "configurePreset": "windows-msvc-x64-release"
    },
    {
      "name": "windows-vs2022-x64-debug",
      "displayName": "Windows | Visual Studio 2022 | Debug",
      "configurePreset": "windows-vs2022-x64",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2022-x64-release",
      "displayName": "Windows | Visual Studio 2022 | Release",
      "configurePreset": "windows-vs2022-x64",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-x64-debug",
      "displayName": "Windows | MSVC x64 | Debug tests",
      "configurePreset": "windows-msvc-x64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-x64-release",
      "displayName": "Windows | MSVC x64 | Release tests",
      "configurePreset": "windows-msvc-x64-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-vs2022-x64-debug",
      "displayName": "Windows | Visual Studio 2022 | Debug tests",
      "configurePreset": "windows-vs2022-x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-vs2022-x64-release",
      "displayName": "Windows | Visual Studio 2022 | Release tests",
      "configurePreset": "windows-vs2022-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
