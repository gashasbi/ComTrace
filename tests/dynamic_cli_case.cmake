if(NOT DEFINED COMTRACE_EXE OR NOT DEFINED FIXTURE_EXE OR NOT DEFINED MANIFEST_FILE OR NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "Missing test arguments.")
endif()
file(MAKE_DIRECTORY "${TEST_DIR}")
set(ETL_FILE "${TEST_DIR}/dynamic_test.etl")
execute_process(COMMAND wevtutil.exe um "${MANIFEST_FILE}" RESULT_VARIABLE uninstall_status OUTPUT_QUIET ERROR_QUIET)
execute_process(COMMAND wevtutil.exe im "${MANIFEST_FILE}" RESULT_VARIABLE install_status OUTPUT_VARIABLE install_output ERROR_VARIABLE install_error)
if(NOT install_status EQUAL 0)
    message(FATAL_ERROR "Manifest installation failed: ${install_error}")
endif()
execute_process(COMMAND "${FIXTURE_EXE}" "${ETL_FILE}" RESULT_VARIABLE fixture_status OUTPUT_VARIABLE fixture_output ERROR_VARIABLE fixture_error)
if(NOT fixture_status EQUAL 0)
    execute_process(COMMAND wevtutil.exe um "${MANIFEST_FILE}" OUTPUT_QUIET ERROR_QUIET)
    message(FATAL_ERROR "Fixture failed: ${fixture_error}")
endif()
execute_process(COMMAND "${COMTRACE_EXE}" --inspect "${ETL_FILE}" RESULT_VARIABLE inspect_status OUTPUT_VARIABLE inspect_output ERROR_VARIABLE inspect_error)
if(NOT inspect_status EQUAL 0)
    execute_process(COMMAND wevtutil.exe um "${MANIFEST_FILE}" OUTPUT_QUIET ERROR_QUIET)
    message(FATAL_ERROR "Inspect failed: ${inspect_error}")
endif()

function(assert_property_search name operator value expected_count label)
    execute_process(
        COMMAND "${COMTRACE_EXE}" --search "${ETL_FILE}" --property "${name}" "--${operator}" "${value}" --max-events 10
        RESULT_VARIABLE search_status
        OUTPUT_VARIABLE search_output
        ERROR_VARIABLE search_error
    )
    if(NOT search_status EQUAL 0)
        execute_process(COMMAND wevtutil.exe um "${MANIFEST_FILE}" OUTPUT_QUIET ERROR_QUIET)
        message(FATAL_ERROR "${label} property search failed: ${search_error}${search_output}")
    endif()
    string(FIND "${search_output}" "Events matching filters: ${expected_count}" search_match)
    if(search_match EQUAL -1)
        execute_process(COMMAND wevtutil.exe um "${MANIFEST_FILE}" OUTPUT_QUIET ERROR_QUIET)
        message(FATAL_ERROR "${label} property search returned an unexpected result: ${search_output}")
    endif()
endfunction()

assert_property_search(Text equals Hello 1 "Unicode equality")
assert_property_search(Text contains ell 1 "Unicode contains")
assert_property_search(Utf8Text equals café 1 "UTF-8 string equality")
assert_property_search(Utf8Text contains fé 1 "UTF-8 string contains")
assert_property_search(Utf8Text equals cafe 0 "UTF-8 string no-match")
assert_property_search(JsonText contains café 1 "JSON UTF-8 string output")
assert_property_search(XmlText contains café 1 "XML UTF-8 string output")
assert_property_search(Data equals hex:deadbeef 1 "Binary exact match")
assert_property_search(Data equals hex:deadbeee 0 "Binary exact no-match")
assert_property_search(Data contains hex:dead 1 "Binary contains prefix")
assert_property_search(Data contains hex:adbe 1 "Binary contains middle")
assert_property_search(Data contains hex:cafe 0 "Binary contains no-match")
assert_property_search(Data contains dead 0 "Binary contains requires hexadecimal bytes")
assert_property_search(Data contains hex:dea 0 "Binary contains rejects odd-length patterns")
assert_property_search(Sid equals S-1-5-32-544 1 "SID equality")
assert_property_search(Sid equals S-1-5-32-545 0 "SID no-match")
assert_property_search(AddressV4 equals 127.0.0.1 1 "IPv4 formatting")
assert_property_search(AddressV6 equals 2001:db8::1 1 "IPv6 formatting")
assert_property_search(AddressV6 equals 2001:db8::2 0 "IPv6 no-match")
assert_property_search(SocketAddress equals 192.0.2.10:443 1 "Socket address formatting")
assert_property_search(SocketAddress equals 192.0.2.10:444 0 "Socket address port mismatch")
assert_property_search(SocketAddressV6 equals [2001:db8::1]:443 1 "IPv6 socket address formatting")
assert_property_search(SocketAddressV6 equals [2001:db8::1]:444 0 "IPv6 socket address port mismatch")
assert_property_search(SocketAddressOther equals hex:34120102112233445566778899aabbcc 1 "Unknown socket address family hex fallback")
assert_property_search(HResult equals 0x80004005 1 "HRESULT equality")
assert_property_search(HResult greater-than 0x80004004 1 "HRESULT numeric ordering")
assert_property_search(HResult less-than 0x80004005 0 "HRESULT comparison boundary")
assert_property_search(Hex8 equals 0xAB 1 "8-bit hexadecimal output")
assert_property_search(Hex16 equals 0xCDEF 1 "16-bit hexadecimal output")
assert_property_search(Hex32 equals 0x89ABCDEF 1 "32-bit hexadecimal output")
assert_property_search(Hex64 equals 0x0123456789ABCDEF 1 "64-bit hexadecimal output")
assert_property_search(ErrorCode equals 0x00000005 1 "ErrorCode hexadecimal output")
assert_property_search(NtStatus equals 0xC0000005 1 "NTSTATUS hexadecimal output")
assert_property_search(CodePointer equals 0x12345678 1 "CodePointer hexadecimal output")
assert_property_search(Port equals 443 1 "Port output type")
assert_property_search(Port equals 444 0 "Port mismatch")
assert_property_search(Win32Error equals 0x00000005 1 "Win32Error hexadecimal output")
assert_property_search(Win32Error greater-than 0x00000004 1 "Win32Error numeric comparison")
assert_property_search(MappedStatus equals 1 1 "Value map raw numeric equality")
assert_property_search(MappedStatus equals Busy 0 "Value map label is not the raw value")
assert_property_search(MappedFlags equals 3 1 "Bitmap raw numeric equality")
assert_property_search(Count equals 3 1 "Numeric equality")
assert_property_search(Count equals 4 0 "Numeric no-match")
assert_property_search(Count greater-than 2 1 "Numeric greater-than")
assert_property_search(Count greater-than 3 0 "Numeric greater-than boundary")
assert_property_search(Count greater-or-equal 3 1 "Numeric greater-or-equal")
assert_property_search(Count less-than 4 1 "Numeric less-than")
assert_property_search(Count less-than 3 0 "Numeric less-than boundary")
assert_property_search(Count less-or-equal 3 1 "Numeric less-or-equal")
assert_property_search(Count contains 3 0 "Contains rejects numeric properties")
assert_property_search(WideValue greater-than 9007199254740992 1 "64-bit greater-than precision")
assert_property_search(WideValue greater-than 9007199254740993 0 "64-bit greater-than boundary")
assert_property_search(WideValue less-than 9007199254740994 1 "64-bit less-than precision")
assert_property_search(WideValue less-or-equal 9007199254740993 1 "64-bit less-or-equal precision")
assert_property_search(Text greater-than 2 0 "Ordering rejects string properties")
assert_property_search(Values equals 11 0 "Array property requires an index")
assert_property_search(Values[0] equals 11 1 "Dynamic array first element")
assert_property_search(Values[1] equals 22 1 "Dynamic array middle element")
assert_property_search(Values[2] equals 33 1 "Dynamic array last element")
assert_property_search(Values[1] equals 11 0 "Dynamic array index mismatch")
assert_property_search(Values[3] equals 44 0 "Dynamic array out-of-range")
assert_property_search(Values[1] greater-than 21 1 "Dynamic array numeric comparison")
assert_property_search(HexValues[1] equals 55 1 "UInt32-counted array element")
assert_property_search(ByteValues[0] equals -7 1 "UInt8-counted array element")
assert_property_search(SignedValues[0] equals -13 1 "Signed-count array first element")
assert_property_search(SignedValues[1] equals 27 1 "Signed-count array second element")
assert_property_search(SignedValues[2] equals 27 0 "Signed-count array out-of-range")
assert_property_search(Text equals Goodbye 0 "Property no-match")
foreach(expected "name=AddressV4 value=127.0.0.1" "name=AddressV6 value=2001:db8::1" "name=SocketAddress value=192.0.2.10:443" "name=SocketAddressV6 value=[2001:db8::1]:443" "name=SocketAddressOther value=hex:34120102112233445566778899aabbcc" "name=HResult value=0x80004005" "name=Utf8Text value=\"caf\\u00e9\"" "name=Hex8 value=0xAB" "name=Hex16 value=0xCDEF" "name=Hex32 value=0x89ABCDEF" "name=Hex64 value=0x0123456789ABCDEF" "name=ErrorCode value=0x00000005" "name=NtStatus value=0xC0000005" "name=CodePointer value=0x12345678" "name=Port value=443" "name=Win32Error value=0x00000005" "name=MappedStatus value=\"Busy\"" "name=MappedFlags value=\"Read")
    string(FIND "${inspect_output}" "${expected}" found)
    if(found EQUAL -1)
        execute_process(COMMAND wevtutil.exe um "${MANIFEST_FILE}" OUTPUT_QUIET ERROR_QUIET)
        message(FATAL_ERROR "Missing formatted IP property: ${expected}\n${inspect_output}")
    endif()
endforeach()

execute_process(
    COMMAND "${COMTRACE_EXE}" --search "${ETL_FILE}" --property Text
    RESULT_VARIABLE missing_operator_status
    OUTPUT_VARIABLE missing_operator_output
    ERROR_VARIABLE missing_operator_error
)
if(missing_operator_status EQUAL 0 OR
   NOT "${missing_operator_output}${missing_operator_error}" MATCHES "Use --property with exactly one comparison operator")
    execute_process(COMMAND wevtutil.exe um "${MANIFEST_FILE}" OUTPUT_QUIET ERROR_QUIET)
    message(FATAL_ERROR "A property filter without an operator was accepted.")
endif()

execute_process(
    COMMAND "${COMTRACE_EXE}" --search "${ETL_FILE}" --property "Values[4096]" --equals 22
    RESULT_VARIABLE invalid_index_status
    OUTPUT_VARIABLE invalid_index_output
    ERROR_VARIABLE invalid_index_error
)
if(invalid_index_status EQUAL 0 OR
   NOT "${invalid_index_output}${invalid_index_error}" MATCHES "Invalid property array index")
    execute_process(COMMAND wevtutil.exe um "${MANIFEST_FILE}" OUTPUT_QUIET ERROR_QUIET)
    message(FATAL_ERROR "An out-of-range property array index was accepted.")
endif()

execute_process(COMMAND wevtutil.exe um "${MANIFEST_FILE}" RESULT_VARIABLE cleanup_status OUTPUT_QUIET ERROR_QUIET)
if(NOT cleanup_status EQUAL 0)
    message(FATAL_ERROR "Manifest cleanup failed.")
endif()
foreach(expected "name=Values[0] value=11" "name=Values[1] value=22" "name=Values[2] value=33" "name=Data value=hex:deadbeef" "name=HexValues[0] value=44" "name=HexValues[1] value=55" "name=ByteValues[0] value=-7" "name=ByteValues[1] value=8" "name=Text value=\"Hello\"" "name=FixedData value=hex:11223344" "name=FixedText value=\"Fixed\"" "name=Sid value=S-1-5-32-544")
    string(FIND "${inspect_output}" "${expected}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Missing expected dynamic property value: ${expected}\n${inspect_output}")
    endif()
endforeach()
string(REPEAT "ab" 5000 large_data_hex)
string(FIND "${inspect_output}" "name=LargeData value=hex:${large_data_hex}" large_data_position)
if(large_data_position EQUAL -1)
    message(FATAL_ERROR "Large binary property was not completely decoded.")
endif()
message(STATUS "Dynamic-count arrays, counted properties, SID conversion, and complete 5000-byte binary decoding passed.")
