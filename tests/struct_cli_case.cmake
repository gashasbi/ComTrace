if(NOT DEFINED COMTRACE_EXE OR NOT DEFINED FIXTURE_EXE OR NOT DEFINED MANIFEST_FILE OR NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "Missing test arguments.")
endif()
file(MAKE_DIRECTORY "${TEST_DIR}")
set(ETL_FILE "${TEST_DIR}/struct_test.etl")
execute_process(COMMAND wevtutil.exe um "${MANIFEST_FILE}" RESULT_VARIABLE uninstall_status OUTPUT_QUIET ERROR_QUIET)
execute_process(COMMAND wevtutil.exe im "${MANIFEST_FILE}" RESULT_VARIABLE install_status OUTPUT_VARIABLE install_output ERROR_VARIABLE install_error)
if(NOT install_status EQUAL 0)
    message(FATAL_ERROR "Manifest installation failed: ${install_error}")
endif()
execute_process(COMMAND "${FIXTURE_EXE}" "${ETL_FILE}" RESULT_VARIABLE fixture_status OUTPUT_VARIABLE fixture_output ERROR_VARIABLE fixture_error)
if(NOT fixture_status EQUAL 0)
    execute_process(COMMAND wevtutil.exe um "${MANIFEST_FILE}" OUTPUT_QUIET ERROR_QUIET)
    message(FATAL_ERROR "Fixture failed with status ${fixture_status}: ${fixture_output} ${fixture_error}")
endif()
execute_process(COMMAND "${COMTRACE_EXE}" --inspect "${ETL_FILE}" RESULT_VARIABLE inspect_status OUTPUT_VARIABLE inspect_output ERROR_VARIABLE inspect_error)
foreach(search_case IN ITEMS "Outer.Code|equals|287454020|1" "Outer.Inner.NestedCode|equals|1432778632|1" "Outer.Inner.NestedStatus|greater-than|39337|1" "Outer.Inner.NestedStatus|equals|1|0" "Outer.Missing|equals|1|0" "Values[0].Code|equals|287454020|1" "Values[1].Code|equals|1432778632|1" "Values[1].Status|equals|39338|1" "FixedValues[1].Code|equals|270544960|1" "Values.Code|equals|287454020|0 "Values[2].Code|equals|1432778632|0" "Outer.Inner[0].NestedCode|equals|2864434397|1" "Outer.Inner[1].NestedCode|equals|287484603|1" "Outer.Numbers[1]|equals|47|1" "Outer.Numbers[2]|equals|47|0")
    string(REPLACE "|" ";" search_fields "${search_case}")
    list(GET search_fields 0 property_name)
    list(GET search_fields 1 operator)
    list(GET search_fields 2 expected_value)
    list(GET search_fields 3 expected_count)
    execute_process(
        COMMAND "${COMTRACE_EXE}" --search "${ETL_FILE}" --property "${property_name}" "--${operator}" "${expected_value}" --max-events 10
        RESULT_VARIABLE search_status
        OUTPUT_VARIABLE search_output
        ERROR_VARIABLE search_error
    )
    if(NOT search_status EQUAL 0)
        execute_process(COMMAND wevtutil.exe um "${MANIFEST_FILE}" OUTPUT_QUIET ERROR_QUIET)
        message(FATAL_ERROR "Nested property search failed for ${property_name}: ${search_error}${search_output}")
    endif()
    string(FIND "${search_output}" "Events matching filters: ${expected_count}" search_match)
    if(search_match EQUAL -1)
        execute_process(COMMAND wevtutil.exe um "${MANIFEST_FILE}" OUTPUT_QUIET ERROR_QUIET)
        message(FATAL_ERROR "Nested property search returned an unexpected result for ${property_name}: ${search_output}")
    endif()
endforeach()
execute_process(COMMAND wevtutil.exe um "${MANIFEST_FILE}" RESULT_VARIABLE cleanup_status OUTPUT_QUIET ERROR_QUIET)
if(NOT inspect_status EQUAL 0)
    message(FATAL_ERROR "Inspect failed: ${inspect_error}")
endif()
foreach(expected "name=Values[0].Code value=287454020" "name=Values[0].Status value=21862" "name=Values[1].Code value=1432778632" "name=Values[1].Status value=39338" "name=FixedValues[0].Code value=2712847316" "name=FixedValues[0].Status value=4660" "name=FixedValues[1].Code value=270544960" "name=FixedValues[1].Status value=22136" "name=Outer.Code value=287454020" "name=Outer.Inner.NestedCode value=1432778632" "name=Outer.Inner.NestedStatus value=39338")
    string(FIND "${inspect_output}" "${expected}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Missing expected struct value: ${expected}\\n${inspect_output}")
    endif()
endforeach()
message(STATUS "Dynamic and fixed struct arrays and nested TraceLogging structures were decoded correctly.")
